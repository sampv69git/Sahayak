<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/windowBackground">

    <TextView
        android:id="@+id/tvPensionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pension_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvNoPensionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_pension_record"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="50dp"
        android:visibility="gone"
        android:textColor="?android:attr/textColorSecondary"/>

    <LinearLayout
        android:id="@+id/layoutPensionContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPensionAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monthly_pension_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvSelectYearLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_year"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"/>

            <Spinner
                android:id="@+id/spinnerYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPensionHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"/>
    </LinearLayout>
</LinearLayout>